rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Any signed-in user can browse profiles (needed for the tutors list)
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      // Owners can edit their own profile. Other users may only touch the
      // rating rollup fields, written when a student rates a completed session.
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'ratingSum', 'reviewsCount'])
      );
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      function isParticipant() {
        return signedIn() && (
          request.auth.uid == resource.data.studentId ||
          request.auth.uid == resource.data.tutorId
        );
      }
      // Only the two people in a session can see it
      allow read: if isParticipant();
      // Students create their own requests, always starting as pending
      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Participants can move the session through its lifecycle, but can
      // never reassign it to different people
      allow update: if isParticipant()
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.tutorId == resource.data.tutorId;
      allow delete: if false;
    }

    // Phone number registry — doc ID is the normalized number, so a number
    // can only ever be claimed by one account (create fails if it exists,
    // and only the owner can overwrite or release it).
    match /phones/{phone} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /groups/{groupId} {
      // Only tutor accounts may list a WhatsApp group
      function isTutor() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'tutor';
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid && isTutor();
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
